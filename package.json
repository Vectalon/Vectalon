{
  "name": "vectalon",
  "private": true,
  "version": "0.6.0-beta.1",
  "description": "Vectalon monorepo — the adaptive AI harness for React Native and beyond",
  "workspaces": [
    "apps/*",
    "packages/*",
    "!apps/website/demo/**"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "publish:core": "turbo run publish --filter=@vectalon-dev/core",
    "publish:rn": "turbo run publish --filter=@vectalon-dev/rn",
    "publish:all": "turbo run publish --filter=@vectalon-dev/*"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "pnpm@9.0.0+sha512.b4106707c7225b1748b61595953ccbebff97b54ad05d002aa3635f633b9c53cd666f7ce9b8bc44704f1fa048b9a49b55371ab2d9e9d667d1efe2ef1514bcd513"
}
