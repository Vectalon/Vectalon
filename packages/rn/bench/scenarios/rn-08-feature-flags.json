{
  "id": "rn-08-feature-flags",
  "specVersion": 1,
  "suite": "core-ui",
  "title": "Feature-flag wrapper component and hook",
  "prompt": "Create a typed FeatureFlag component and useFeatureFlag hook driven by a config file. No hardcoded URLs or any types.",
  "scaffoldable": false,
  "fixtures": {
    "package.json": "{\n  \"name\": \"rn-bench-app\",\n  \"version\": \"1.0.0\",\n  \"scripts\": {\n    \"test\": \"jest\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"lint\": \"eslint .\"\n  },\n  \"dependencies\": {\n    \"react\": \"18.3.1\",\n    \"react-native\": \"0.74.0\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"5.5.0\",\n    \"jest\": \"29.7.0\"\n  }\n}",
    "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"strict\": true,\n    \"jsx\": \"react-native\",\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true\n  }\n}",
    "src/config/flags.ts": "export type FeatureFlag = 'newOnboarding' | 'darkMode' | 'betaPayments';\n\nexport const flags: Record<FeatureFlag, boolean> = {\n  newOnboarding: true,\n  darkMode: false,\n  betaPayments: false\n};"
  },
  "expect": {
    "files": ["src/components/FeatureFlag.tsx", "src/hooks/useFeatureFlag.ts"],
    "behaviors": [
      "config-driven flags, no hardcoded URLs",
      "typed props and no any",
      "proper hook dependency arrays",
      "named exports"
    ]
  },
  "correctness": { "tests": true, "typecheck": true, "lint": true },
  "axes": ["correctness", "adherence", "guardrails"]
}
