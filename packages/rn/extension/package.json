{
  "name": "vectalon",
  "displayName": "Vectalon — React Native harness",
  "description": "Project-aware React Native workflows, inline guardrail status, and the team knowledge base — powered by the vectalon MCP server.",
  "version": "0.1.0",
  "publisher": "vectalon-dev",
  "license": "MIT",
  "icon": "media/vectalon-icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vectalon/Vectalon.git"
  },
  "homepage": "https://github.com/Vectalon/Vectalon",
  "bugs": {
    "url": "https://github.com/Vectalon/Vectalon/issues"
  },
  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://github.com/Vectalon/Vectalon/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/Vectalon/Vectalon/actions/workflows/ci.yml",
      "description": "CI status"
    },
    {
      "url": "https://github.com/Vectalon/Vectalon/actions/workflows/publish.yml/badge.svg",
      "href": "https://github.com/Vectalon/Vectalon/actions/workflows/publish.yml",
      "description": "Release pipeline"
    }
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "1.95.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Testing"
  ],
  "keywords": [
    "react-native",
    "mcp",
    "ai",
    "workflows",
    "knowledge-base",
    "guardrails"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:vectalon.knowledgeView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vectalon",
          "title": "Vectalon",
          "icon": "media/vectalon.svg"
        }
      ]
    },
    "views": {
      "vectalon": [
        {
          "id": "vectalon.knowledgeView",
          "name": "Knowledge Base",
          "when": "vectalon.connected"
        }
      ]
    },
    "commands": [
      {
        "command": "vectalon.runFeatureWorkflow",
        "title": "[beta] Vectalon: Run Feature Workflow"
      },
      {
        "command": "vectalon.reviewCode",
        "title": "[experimental] Vectalon: Review Code (current file)",
        "enablement": "config.vectalon.experimentalCapabilities"
      },
      {
        "command": "vectalon.checkGuardrails",
        "title": "[beta] Vectalon: Check Guardrails (current file)"
      },
      {
        "command": "vectalon.generateComponent",
        "title": "[experimental] Vectalon: Generate Component",
        "enablement": "config.vectalon.experimentalCapabilities"
      },
      {
        "command": "vectalon.archiveBuild",
        "title": "[experimental] Vectalon: Archive Build",
        "enablement": "config.vectalon.experimentalCapabilities"
      },
      {
        "command": "vectalon.distributeBuild",
        "title": "[experimental] Vectalon: Distribute Build (dry-run plan)",
        "enablement": "config.vectalon.experimentalCapabilities"
      },
      {
        "command": "vectalon.shareBuild",
        "title": "[experimental] Vectalon: Share Build (local server)",
        "enablement": "config.vectalon.experimentalCapabilities"
      },
      {
        "command": "vectalon.generatePortal",
        "title": "[experimental] Vectalon: Generate Build Portal",
        "enablement": "config.vectalon.experimentalCapabilities"
      },
      {
        "command": "vectalon.projectContext",
        "title": "[beta] Vectalon: Show Project Context"
      },
      {
        "command": "vectalon.searchKnowledge",
        "title": "[experimental] Vectalon: Search Knowledge Base",
        "enablement": "config.vectalon.experimentalCapabilities"
      },
      {
        "command": "vectalon.refreshKnowledge",
        "title": "[experimental] Vectalon: Refresh Knowledge View",
        "enablement": "config.vectalon.experimentalCapabilities"
      },
      {
        "command": "vectalon.startServer",
        "title": "[beta] Vectalon: Start MCP Server"
      },
      {
        "command": "vectalon.restartServer",
        "title": "[beta] Vectalon: Restart MCP Server"
      },
      {
        "command": "vectalon.stopServer",
        "title": "[beta] Vectalon: Stop MCP Server"
      }
    ],
    "configuration": {
      "title": "Vectalon",
      "properties": {
        "vectalon.url": {
          "type": "string",
          "default": "http://localhost:8765",
          "description": "Base URL of the vectalon MCP HTTP server (vectalon serve --protocol http --port 8765)."
        },
        "vectalon.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically spawn `vectalon serve --protocol http` when the extension activates and no server is reachable."
        },
        "vectalon.guardrailsOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run guardrail checks on the active file and surface findings in the Problems panel."
        },
        "vectalon.experimentalCapabilities": {
          "type": "boolean",
          "default": false,
          "description": "Show and allow experimental Vectalon commands. This does not grant paid entitlements."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
