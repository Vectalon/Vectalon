{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://contracts.vectalon.dev/v1/ProductDefinition.schema.json",
    "title": "ProductDefinition",
    "type": "object",
    "required": ["contractVersion", "product", "packages", "platforms", "capabilities", "plans", "license", "validation"],
    "properties": {
        "contractVersion": { "const": "1.0.0" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "product": { "type": "object", "required": ["id", "name", "releaseStatus", "flagship"], "properties": {
                "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
                "releaseStatus": { "enum": ["beta", "available", "retired"] }, "flagship": { "type": "string", "minLength": 1 }
            } },
        "packages": { "type": "object", "required": ["reactNative", "core"], "properties": {
                "reactNative": { "type": "object", "required": ["name", "version", "status"], "properties": {
                        "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
                        "status": { "enum": ["beta", "available", "retired"] }
                    } },
                "core": { "type": "object", "required": ["name", "version", "distribution", "contractRevision"], "properties": {
                        "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
                        "distribution": { "enum": ["bundled-private-runtime", "package"] }, "contractRevision": { "type": "string", "pattern": "^1\\.0\\.0\\+[a-f0-9]{64}$" }
                    } }
            } },
        "platforms": { "type": "object", "required": ["reactNative", "ios", "android", "flutter", "python"], "properties": {
                "reactNative": { "enum": ["beta", "available", "coming-soon", "retired"] }, "ios": { "enum": ["beta", "available", "coming-soon", "retired"] },
                "android": { "enum": ["beta", "available", "coming-soon", "retired"] }, "flutter": { "enum": ["beta", "available", "coming-soon", "retired"] },
                "python": { "enum": ["beta", "available", "coming-soon", "retired"] }
            }, "additionalProperties": { "enum": ["beta", "available", "coming-soon", "retired"] } },
        "capabilities": { "type": "object", "required": ["benchmarkScenarios", "deterministicCommands", "mcpTools"], "properties": {
                "benchmarkScenarios": { "type": "integer", "minimum": 0 }, "deterministicCommands": { "type": "integer", "minimum": 0 }, "mcpTools": { "type": "integer", "minimum": 0 }
            } },
        "plans": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name", "engineTier", "price", "seatQuantity", "billingCadence", "taxTreatment", "trialEligibility", "gracePolicy", "productScope", "checkout", "features"], "properties": {
                    "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "engineTier": { "enum": ["free", "pro", "team", "enterprise"] },
                    "price": { "type": "object", "required": ["currency", "minorUnits"], "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "minorUnits": { "type": "integer", "minimum": 0 } } },
                    "seatQuantity": { "type": "object", "required": ["minimum", "maximum", "unit"], "properties": { "minimum": { "type": "integer", "minimum": 1 }, "maximum": { "type": ["integer", "null"], "minimum": 1 }, "unit": { "const": "developer" } } },
                    "billingCadence": { "enum": ["none", "monthly", "annual", "custom"] }, "taxTreatment": { "enum": ["exclusive", "inclusive", "not-applicable", "quoted"] },
                    "trialEligibility": { "type": "object", "required": ["eligible"], "properties": { "eligible": { "type": "boolean" }, "durationDays": { "type": "integer", "minimum": 1 } } },
                    "gracePolicy": { "type": "object", "required": ["offlineDays", "paymentFailureDays"], "properties": { "offlineDays": { "type": "integer", "minimum": 0 }, "paymentFailureDays": { "type": "integer", "minimum": 0 } } },
                    "productScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "checkout": { "enum": ["none", "checkout", "sales"] },
                    "features": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
                    }
                } } },
        "license": { "type": "object", "required": ["id", "freeCommercialDevelopers", "changeDate", "changeLicense", "vscodeExtension"], "properties": {
                "id": { "type": "string", "minLength": 1 }, "freeCommercialDevelopers": { "type": "integer", "minimum": 0 }, "changeDate": { "type": "string", "format": "date" },
                "changeLicense": { "type": "string", "minLength": 1 }, "vscodeExtension": { "type": "string", "minLength": 1 }
            } },
        "validation": { "type": "object", "required": ["documents"], "properties": { "documents": { "type": "array", "items": { "type": "object", "required": ["path", "facts"], "properties": {
                            "path": { "type": "string", "minLength": 1 }, "facts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                        } } } } }
    }
}
