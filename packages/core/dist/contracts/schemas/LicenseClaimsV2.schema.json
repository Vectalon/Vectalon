{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vectalon.dev/v2/LicenseClaims.schema.json",
  "title": "LicenseClaimsV2",
  "description": "The exact signed JWT payload consumed by Vectalon Core for a version-2 license. Authenticated header metadata is returned separately by verifyLicenseWithPolicy().",
  "x-contractVersion": "2.0.0",
  "type": "object",
  "required": ["license_version", "jti", "iss", "aud", "sub", "product", "tier", "seats", "state", "iat", "nbf", "exp"],
  "properties": {
    "license_version": { "const": 2 },
    "jti": { "type": "string", "minLength": 1 },
    "iss": { "type": "string", "minLength": 1 },
    "aud": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }] },
    "sub": { "type": "string", "minLength": 1 },
    "product": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "tier": { "type": "string", "minLength": 1 },
    "seats": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "state": { "enum": ["pending", "active", "grace", "suspended", "expired", "canceled", "refunded", "revoked", "superseded"] },
    "iat": { "type": "integer", "minimum": 0, "maximum": 9007199254740 },
    "nbf": { "type": "integer", "minimum": 0, "maximum": 9007199254740 },
    "exp": { "type": "integer", "minimum": 0, "maximum": 9007199254740 }
  }
}
