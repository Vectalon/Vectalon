# 03 - arch: the module graph of the 19-screen app — screens, hooks, services
Output "clips/03-arch.mp4"
Set Width 1440
Set Height 900
Set FontSize 16
Set Padding 24
Set TypingSpeed 30ms
Set Shell bash

Type "cd ../login-app"
Enter
Sleep 600ms
Type "export VECTALON_DEV_MODE=1"
Enter
Sleep 400ms
Type "ls src/screens"
Enter
Sleep 1600ms
Type "node ../../../../packages/rn/bin/rn-vectalon.js arch"
Enter
Sleep 5000ms
Sleep 3s
