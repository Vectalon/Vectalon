# 09-right - outcomes: engineering outcomes, not feature counts (v0.13.0)
Output "clips/09-outcomes.mp4"
Set Width 720
Set Height 900
Set FontSize 16
Set Padding 24
Set TypingSpeed 30ms
Set Shell bash

Type "cd ../login-app"
Enter
Sleep 600ms
Type "export VECTALON_DEV_MODE=1"
Enter
Sleep 400ms
Type "node ../../../../packages/rn/bin/rn-vectalon.js outcomes"
Enter
Sleep 2500ms
Sleep 3s
