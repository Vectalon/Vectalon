{
  "regions": [
    "iad1"
  ],
  "env": {
    "DATA_DIR": "/tmp/vectalon-data"
  },
  "rewrites": [
    {
      "source": "/api/internal/trials/issue",
      "destination": "/api/v1/trial"
    },
    {
      "source": "/kinsfold/privacy",
      "destination": "/kinsfold/privacy.html"
    },
    {
      "source": "/kinsfold/terms",
      "destination": "/kinsfold/terms.html"
    },
    {
      "source": "/kinsfold/health-disclaimer",
      "destination": "/kinsfold/health-disclaimer.html"
    }
  ],
  "redirects": [
    {
      "source": "/familyOS/:page(privacy|terms|health-disclaimer)",
      "destination": "/kinsfold/:page",
      "permanent": true
    },
    {
      "source": "/familyOS/:page(privacy|terms|health-disclaimer).html",
      "destination": "/kinsfold/:page",
      "permanent": true
    }
  ]
}
